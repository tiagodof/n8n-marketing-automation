# n8n instance
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# OpenAI
OPENAI_API_KEY=sk-...
# Optional overrides for the AI analysis client
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

# Google Analytics 4
GA4_PROPERTY_ID=123456789
# Service account JSON key as a single-line JSON string
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project"}

# Meta Ads
META_APP_ID=...
META_APP_SECRET=...
META_ACCESS_TOKEN=...
META_AD_ACCOUNT_ID=act_...

# LinkedIn Ads
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...
LINKEDIN_AD_ACCOUNT_ID=123456789
# Optional: versioned Marketing API header. Defaults to the version in the client.
LINKEDIN_API_VERSION=202608
# Optional JSON mapping of campaign IDs to names when names are not resolved upstream.
LINKEDIN_CAMPAIGN_NAMES={"123456789":"Lead Generation Q3"}

# Email delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=...
REPORT_RECIPIENT_EMAIL=recipient@email.com
